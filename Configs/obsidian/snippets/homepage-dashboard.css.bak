/* Homepage estudos */
body:has(.estudos-home) {
  --file-line-width: 100vw !important;
  --line-width: 100vw !important;
  --line-width-wide: 100vw !important;
}

.estudos-folders span {
  color: var(--muted);
  text-transform: lowercase;
}

.estudos-folders span:first-child {
  color: var(--accent);
}

body:has(.estudos-home) .workspace-leaf-content,
body:has(.estudos-home) .view-content,
body:has(.estudos-home) .markdown-reading-view,
body:has(.estudos-home) .markdown-preview-view,
body:has(.estudos-home) .markdown-source-view,
body:has(.estudos-home) .cm-scroller,
body:has(.estudos-home) .markdown-preview-sizer,
body:has(.estudos-home) .markdown-preview-section,
body:has(.estudos-home) .cm-content,
body:has(.estudos-home) .cm-contentContainer {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
}

body:has(.estudos-home) .inline-title,
body:has(.estudos-home) .metadata-container,
body:has(.estudos-home) .metadata-properties,
body:has(.estudos-home) .metadata-property,
body:has(.estudos-home) .metadata-add-button {
  display: none !important;
}

.estudos-home .estudos-page {
  --accent: #c4a8ff;
  --bright: #f0edf5;
  --muted: #9c98a7;
  --line: rgba(240, 237, 245, 0.13);
  box-sizing: border-box;
  width: min(100%, 1120px);
  min-height: 100vh;
  margin: 0 auto;
  padding: 1.25rem clamp(1.25rem, 5vw, 4.5rem) 3rem;
  color: var(--bright);
  font-family: var(--font-text);
}

.estudos-header,
.estudos-header nav,
.estudos-roadmap,
.estudos-stats {
  display: flex;
  align-items: center;
}

.estudos-header {
  justify-content: space-between;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--line);
}

.estudos-brand,
.estudos-header nav span,
.estudos-label,
.estudos-roadmap-info a {
  font-family: var(--font-monospace);
}

.estudos-brand {
  color: var(--bright);
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
}

.estudos-brand span {
  color: var(--accent);
  font-size: 1.3rem;
}

.estudos-header nav {
  gap: clamp(0.7rem, 2vw, 1.5rem);
  flex-wrap: wrap;
  justify-content: center;
}

.estudos-header nav span {
  color: var(--muted);
  font-size: 0.62rem;
  cursor: default;
}

.estudos-hero {
  max-width: 780px;
  margin: 0 auto;
  padding: 4.5rem 0 2rem;
  text-align: center;
}

.estudos-eyebrow,
.estudos-label {
  color: var(--accent);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.estudos-display {
  position: relative;
  padding: 1.7rem clamp(1rem, 4vw, 3rem) 1rem;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background:
    linear-gradient(rgba(196, 168, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(196, 168, 255, 0.035) 1px, transparent 1px);
  background-size: 25px 25px;
  overflow: hidden;
}

.estudos-display::before {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  content: "";
}

.estudos-logo {
  position: relative;
  z-index: 1;
  margin: 0 !important;
  padding: 0 !important;
  color: var(--accent);
  font-family: var(--font-monospace) !important;
  font-size: clamp(0.28rem, 1.05vw, 0.57rem);
  line-height: 1.08;
  text-align: center;
  text-shadow: 0 0 10px rgba(196, 168, 255, 0.35);
  white-space: pre;
  animation: estudos-flicker 7s steps(1, end) infinite;
}

.estudos-scan {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(196, 168, 255, 0.65), transparent);
  box-shadow: 0 0 12px rgba(196, 168, 255, 0.4);
  animation: estudos-scan 4.5s ease-in-out infinite;
}

.estudos-roadmap {
  justify-content: center;
  max-width: 620px;
  margin: 1.8rem auto 0;
  padding: 1.25rem 1.35rem 1.15rem;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: linear-gradient(135deg, rgba(196, 168, 255, 0.08), rgba(196, 168, 255, 0.015));
  text-align: left;
  box-shadow: 0 14px 35px rgba(0, 0, 0, 0.16);
}

.estudos-stats {
  justify-content: center;
  gap: 0;
  max-width: 620px;
  margin: 1.4rem auto 0;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: rgba(240, 237, 245, 0.025);
}

.estudos-stats div {
  display: grid;
  flex: 1;
  gap: 0.18rem;
  padding: 0.85rem 0.75rem;
  text-align: left;
}

.estudos-stats div + div {
  border-left: 1px solid var(--line);
}

.estudos-stats strong {
  color: var(--bright);
  font-family: var(--font-monospace);
  font-size: 1.45rem;
  font-weight: 600;
  line-height: 1;
}

.estudos-stats span {
  color: var(--muted);
  font-family: var(--font-monospace);
  font-size: 0.58rem;
}

.estudos-stats .estudos-stat-index {
  color: var(--accent);
  font-size: 0.52rem;
  letter-spacing: 0.12em;
}

.estudos-roadmap-info {
  width: 100%;
}

.estudos-progress-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.estudos-progress-heading small {
  display: block;
  margin-top: 0.35rem;
  color: var(--muted);
  font-family: var(--font-monospace);
  font-size: 0.58rem;
}

.estudos-progress-heading strong {
  color: var(--bright);
  font-family: var(--font-monospace);
  font-size: 1.7rem;
  font-weight: 500;
}

.estudos-progress-track {
  position: relative;
  height: 7px;
  margin: 0.75rem 0 0.55rem;
  border: 1px solid var(--line);
  border-radius: 99px;
  background: repeating-linear-gradient(90deg, transparent 0, transparent 9px, var(--line) 10px, transparent 11px);
  overflow: hidden;
}

.estudos-progress-track i {
  display: block;
  width: 2.9%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), var(--bright));
  box-shadow: 0 0 14px var(--accent);
}

.estudos-progress-track b {
  position: absolute;
  top: -4px;
  left: 2.9%;
  width: 13px;
  height: 13px;
  border: 2px solid var(--accent);
  border-radius: 50%;
  background: var(--background-primary);
  box-shadow: 0 0 12px var(--accent);
  transform: translateX(-50%);
}

.estudos-progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  color: var(--muted);
  font-family: var(--font-monospace);
  font-size: 0.65rem;
}

.estudos-progress-meta a {
  color: var(--accent);
  text-decoration: none;
}

@keyframes estudos-flicker {
  0%, 16%, 19%, 65%, 100% { opacity: 0.92; filter: brightness(1); }
  17% { opacity: 0.72; filter: brightness(0.8); }
  18% { opacity: 1; filter: brightness(1.18); }
  66% { opacity: 0.82; filter: brightness(0.9); }
}

@keyframes estudos-scan {
  0%, 100% { top: 8%; opacity: 0; }
  12% { opacity: 0.8; }
  70% { top: 92%; opacity: 0.45; }
  82% { opacity: 0; }
}

@media (max-width: 700px) {
  .estudos-home .estudos-page {
    padding: 1rem 0.75rem 2rem;
  }

  .estudos-header nav {
    gap: 0.5rem;
    order: 3;
    width: 100%;
    margin-top: 0.8rem;
  }

  .estudos-header {
    flex-wrap: wrap;
  }

  .estudos-stats {
    width: 100%;
  }

  .estudos-hero {
    padding-top: 3rem;
  }

  .estudos-roadmap {
    justify-content: flex-start;
  }

  .estudos-progress-meta {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.35rem;
  }
}
